<resources>
    <style name="Theme.NexV1" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/white</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">#8E8E93</item>

        <!-- Selection and Cursor colors -->
        <item name="android:textColorHighlight">@color/selection_color</item>
        <item name="colorControlActivated">@color/white</item>
        <item name="colorControlHighlight">@color/selection_color</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/black</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
    </style>
</resources>