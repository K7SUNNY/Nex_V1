<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp"
    android:clipChildren="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/aiAvatar"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="#1C1C1E"
            android:padding="4dp"
            android:src="@drawable/ic_bolt"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            app:tint="@android:color/white" />

        <TextView
            android:id="@+id/tvAiModelLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:letterSpacing="0.05"
            android:text="@string/nex_ai_label"
            android:textColor="#555555"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/memoryIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:letterSpacing="0.05"
            android:text=""
            android:textColor="#8E8E93"
            android:textSize="11sp"
            android:textStyle="italic" />
    </LinearLayout>

    <!-- Thinking Process Accordion Card -->
    <LinearLayout
        android:id="@+id/cardThinkingContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_thinking_card"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Clickable Header Bar -->
        <LinearLayout
            android:id="@+id/layoutThinkingHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="9dp">

            <ImageView
                android:id="@+id/ivThinkingIcon"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_sparkle"
                app:tint="#9A9EA7" />

            <TextView
                android:id="@+id/tvThinkingTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:letterSpacing="0.02"
                android:text="Thought Process"
                android:textColor="#A0A4B0"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivThinkingChevron"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_chevron_down"
                app:tint="#71747E" />
        </LinearLayout>

        <!-- Collapsible Content View -->
        <TextView
            android:id="@+id/tvThinkingContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:textColor="#8E8E93"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/messageText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:lineSpacingExtra="5dp"
        android:textColor="#E3E3E3"
        android:textSize="15sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/messageContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:orientation="vertical" />

    <LinearLayout
        android:id="@+id/typingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clipChildren="false"
        android:visibility="gone">

        <View
            android:id="@+id/dot1"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_dot"
            android:layout_marginEnd="4dp" />

        <View
            android:id="@+id/dot2"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_dot"
            android:layout_marginEnd="4dp" />

        <View
            android:id="@+id/dot3"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_dot" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/aiActionContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnCopy"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Copy response"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_copy"
            app:tint="#71747E" />

        <ImageButton
            android:id="@+id/btnShare"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Share response"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_share"
            app:tint="#71747E" />

        <ImageButton
            android:id="@+id/btnRegenerate"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Regenerate response"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_regenerate"
            app:tint="#71747E" />

        <ImageButton
            android:id="@+id/btnMore"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="More options"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_more_horiz"
            app:tint="#71747E" />
    </LinearLayout>

</LinearLayout>
