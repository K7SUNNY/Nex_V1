<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_dot"
        android:backgroundTint="#333336" />

    <!-- Title Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select System Persona"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:text="Choose how Nex behaves and formats responses."
        android:textColor="#8E8E93"
        android:textSize="13sp" />

    <!-- Presets Container -->
    <LinearLayout
        android:id="@+id/container_persona_presets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- General Assistant Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_persona_general"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#14151B"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#252832"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/iv_icon_general"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_dot"
                    android:backgroundTint="#1F222B"
                    android:padding="6dp"
                    android:src="@drawable/ic_bolt"
                    app:tint="@android:color/white" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="General Assistant"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Balanced, direct and helpful offline assistant."
                        android:textColor="#8E929E"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/iv_check_general"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/bg_dot"
                    android:backgroundTint="#30D158"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Code Expert Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_persona_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#14151B"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#252832"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/iv_icon_code"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_dot"
                    android:backgroundTint="#1F222B"
                    android:padding="6dp"
                    android:src="@drawable/ic_code_brackets"
                    app:tint="@android:color/white" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Code &amp; Architecture Expert"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clean code, best practices, edge cases &amp; zero fluff."
                        android:textColor="#8E929E"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/iv_check_code"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/bg_dot"
                    android:backgroundTint="#30D158"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Creative Writer Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_persona_writer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#14151B"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#252832"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/iv_icon_writer"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_dot"
                    android:backgroundTint="#1F222B"
                    android:padding="6dp"
                    android:src="@drawable/ic_sparkle"
                    app:tint="@android:color/white" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Creative Writer"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Expressive storytelling, rich prose &amp; creative ideas."
                        android:textColor="#8E929E"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/iv_check_writer"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/bg_dot"
                    android:backgroundTint="#30D158"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Socratic Tutor Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_persona_tutor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#14151B"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#252832"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/iv_icon_tutor"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_dot"
                    android:backgroundTint="#1F222B"
                    android:padding="6dp"
                    android:src="@drawable/ic_persona"
                    app:tint="@android:color/white" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Socratic Tutor"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Step-by-step guidance, intuitive analogies &amp; questions."
                        android:textColor="#8E929E"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/iv_check_tutor"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/bg_dot"
                    android:backgroundTint="#30D158"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Concise Summarizer Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_persona_summarizer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#14151B"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#252832"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/iv_icon_summarizer"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_dot"
                    android:backgroundTint="#1F222B"
                    android:padding="6dp"
                    android:src="@drawable/ic_chat"
                    app:tint="@android:color/white" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Concise Summarizer"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dense bullet points, key takeaways and no filler."
                        android:textColor="#8E929E"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/iv_check_summarizer"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/bg_dot"
                    android:backgroundTint="#30D158"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Custom Persona Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_persona_custom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#14151B"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#252832"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/iv_icon_custom"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_dot"
                    android:backgroundTint="#1F222B"
                    android:padding="6dp"
                    android:src="@drawable/ic_settings"
                    app:tint="@android:color/white" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Custom Persona"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Write your own custom prompt instructions."
                        android:textColor="#8E929E"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/iv_check_custom"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/bg_dot"
                    android:backgroundTint="#30D158"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Custom Prompt Editor (Visible when Custom is selected) -->
    <LinearLayout
        android:id="@+id/layout_custom_prompt_editor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/et_custom_persona_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_minimal"
            android:gravity="top|start"
            android:hint="Enter system instructions for the AI..."
            android:minLines="4"
            android:maxLines="8"
            android:padding="12dp"
            android:textColor="@android:color/white"
            android:textColorHint="#626572"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_persona"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="#8E929E" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_persona"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Save"
            app:backgroundTint="@android:color/white"
            android:textColor="@android:color/black"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>
