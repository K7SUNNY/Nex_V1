<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".DrawerActivity">

    <!-- Header Section -->
    <LinearLayout
        android:id="@+id/drawer_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/app_logo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/app_logo"
            app:tint="@android:color/white" />

        <TextView
            android:id="@+id/app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:letterSpacing="0.08"
            android:text="NEX"
            android:textColor="@android:color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_pill_tag"
            android:letterSpacing="0.06"
            android:text="AI"
            android:textColor="#8E929E"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_close"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_dot"
        android:backgroundTint="#14161B"
        android:contentDescription="Close"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_close"
        app:layout_constraintBottom_toBottomOf="@id/drawer_header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/drawer_header"
        app:tint="@android:color/white" />

    <!-- New Chat Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_new_chat"
        style="@style/Widget.Material3.Button"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="#101115"
        android:paddingHorizontal="18dp"
        android:paddingVertical="0dp"
        android:text="New Chat"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="13sp"
        android:textStyle="bold"
        app:cornerRadius="21dp"
        app:icon="@drawable/ic_add"
        app:iconPadding="8dp"
        app:iconSize="16dp"
        app:iconTint="@android:color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/drawer_header"
        app:strokeColor="#242730"
        app:strokeWidth="1dp" />

    <!-- Search Bar -->
    <LinearLayout
        android:id="@+id/search_bar_container"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/bg_search_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_new_chat">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_search"
            app:tint="#71747E" />

        <EditText
            android:id="@+id/search_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Search chats..."
            android:imeOptions="actionSearch"
            android:singleLine="true"
            android:textColor="@android:color/white"
            android:textColorHint="#626572"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/btn_clear_search"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:visibility="gone"
            app:tint="#8E929E" />
    </LinearLayout>

    <!-- SYSTEM Section (Anchored to Bottom) -->
    <LinearLayout
        android:id="@+id/system_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="14dp"
            android:background="#14161C" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:letterSpacing="0.08"
            android:text="@string/system"
            android:textColor="#555862"
            android:textSize="11sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_settings"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:gravity="start|center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/settings"
            android:textColor="#E0E2EC"
            android:textSize="14sp"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_settings"
            app:iconPadding="14dp"
            app:iconSize="20dp"
            app:iconTint="@android:color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_account"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="start|center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/account"
            android:textColor="#E0E2EC"
            android:textSize="14sp"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_account"
            app:iconPadding="14dp"
            app:iconSize="20dp"
            app:iconTint="@android:color/white" />

        <TextView
            android:id="@+id/tv_app_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="6dp"
            android:letterSpacing="0.04"
            android:textColor="#4A4D58"
            android:textSize="11sp"
            tools:text="App version 1.0" />
    </LinearLayout>

    <!-- Scrollable Content (Fills Remaining Space) -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/system_section"
        app:layout_constraintTop_toBottomOf="@id/search_bar_container">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp">

            <!-- MAIN Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="12dp"
                android:letterSpacing="0.08"
                android:text="MAIN"
                android:textColor="#555862"
                android:textSize="11sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nav_chat"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:gravity="start|center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/chat"
                android:textColor="#E0E2EC"
                android:textSize="14sp"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_chat"
                app:iconPadding="14dp"
                app:iconSize="20dp"
                app:iconTint="@android:color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nav_memory"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="start|center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/memory"
                android:textColor="#E0E2EC"
                android:textSize="14sp"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_memory"
                app:iconPadding="14dp"
                app:iconSize="20dp"
                app:iconTint="@android:color/white" />

            <!-- RECENT Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="24dp"
                android:letterSpacing="0.08"
                android:text="RECENT"
                android:textColor="#555862"
                android:textSize="11sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recentChatsRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <!-- Empty State Container -->
            <LinearLayout
                android:id="@+id/layout_empty_state_drawer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="28dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginBottom="10dp"
                    android:src="@drawable/ic_chat"
                    app:tint="#353842" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="No recent chats"
                    android:textColor="#7A7E8C"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Start a conversation to see it here."
                    android:textColor="#4A4D58"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
